# Flask AI API environment variables
# Copy to .env and fill in values

# Port Flask will run on
FLASK_PORT=5001

# Path to your trained YOLOv8 model weights
# Use an absolute path or relative to flask_api directory
MODEL_PATH=../best.pt

# Confidence threshold — detections below this are ignored (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.25

# Debug mode (set to False in production)
FLASK_DEBUG=True
